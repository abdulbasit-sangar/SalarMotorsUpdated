# ─── Server ───────────────────────────────────────────────────────────────────
PORT=xxxxx
NODE_ENV=development       # change to: production  on deploy

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=xxxxxxxxxxx://<username>:<password>@cluster0.xxxxx.mongodb.net/car-marketplace

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_super_secret_access_key_minimum_32_characters
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_minimum_32_characters_different_from_above
REFRESH_TOKEN_EXPIRY=7d

# Required for the one-time initial admin registration endpoint.
ADMIN_SETUP_TOKEN=generate-a-long-random-value

#imagekit 

IMAGEKIT_PUBLIC_KEY=public_key
IMAGEKIT_PRIVATE_KEY=private_key
IMAGEKIT_URL_ENDPOINT=url_endpoint

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development:  http://localhost:3000
# Production:   https://your-frontend-domain.com  (no trailing slash)
FRONTEND_URL=xxxxxxxxxxxx

# ─── Email (SMTP) — used for Admin forgot-password OTP emails ─────────────────
# Any standard SMTP provider works (e.g. Gmail SMTP, SendGrid, Mailgun, SES SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=xxxxxxxxxxxxx
SMTP_PASS=xxxxxxxxxxxxx
# Optional — defaults to SMTP_USER if not set
SMTP_FROM=Salar Motors <no-reply@example.com>
