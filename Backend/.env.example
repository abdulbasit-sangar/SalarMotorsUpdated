# Copy to .env and fill with real values. Never commit a real .env.
NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://user:password@cluster/db

FRONTEND_URL=http://localhost:3000

ACCESS_TOKEN_SECRET=64-hex-chars
REFRESH_TOKEN_SECRET=64-hex-chars-different-from-access
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

OTP_HASH_SECRET=64-hex-chars-different-again

ADMIN_SETUP_TOKEN=64-hex-chars

TRUST_PROXY=0

CAR_MANAGER_OWNERSHIP=false

IMAGEKIT_PUBLIC_KEY=public_key
IMAGEKIT_PRIVATE_KEY=private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
